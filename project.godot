; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Road Rush 3D"
config/description="Jogo 3D low-poly de atravessar a rua: pule entre carros, troncos e trens sem ser pego!"
config/version="0.5.0"
run/main_scene="res://scenes/main/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.16, 0.42, 0.72, 1)
config/icon="res://icon.svg"

[autoload]

SaveManager="*res://scripts/autoload/save_manager.gd"
Loc="*res://scripts/autoload/localization.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
Missions="*res://scripts/autoload/mission_manager.gd"
Ads="*res://scripts/autoload/ads_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[internationalization]

locale/fallback="en"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
anti_aliasing/quality/msaa_3d=0
